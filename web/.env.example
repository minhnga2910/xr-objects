# XR-Objects web demo — environment variables
# Copy to .env.local for `node dev.mjs`, or set these in Vercel → Settings → Environment Variables.

# Gemini (https://aistudio.google.com/app/apikey). Empty = demo mode with sample data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase project URL and publishable/anon key (safe to expose: RLS is enabled).
SUPABASE_URL=
SUPABASE_ANON_KEY=
